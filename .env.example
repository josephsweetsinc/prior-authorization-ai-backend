# Copy this file to .env (production) or .env.dev (local development) and
# fill in real values. Which file is read is controlled by ENV below - see
# config/settings.py.
#
# Nothing in this file is a real secret; every value is a placeholder.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# 'prod' reads .env, 'dev' reads .env.dev (config/settings.py)
ENV=dev
LOG_LEVEL=INFO
DEBUG=false

# ---------------------------------------------------------------------------
# Database (DB_ prefix)
# ---------------------------------------------------------------------------
# Either set DB_URL directly, or leave it unset and provide the individual
# DB_* parameters below - DB_URL takes precedence if both are present.
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paai_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=paai_db
# DB_SSL=true

# ---------------------------------------------------------------------------
# Auth tokens (TOKEN_ prefix)
# ---------------------------------------------------------------------------
TOKEN_SECRET_KEY=change-me
TOKEN_ALGORITHM=HS256
TOKEN_ACCESS_TOKEN_EXPIRE_MINUTES=15
TOKEN_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# AWS / S3 (AWS_ prefix)
# ---------------------------------------------------------------------------
# ACCESS_KEY_ID / SECRET_ACCESS_KEY may be omitted in production if the
# instance uses an IAM role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=paai-uploads

# ---------------------------------------------------------------------------
# Email (EMAIL_ prefix)
# ---------------------------------------------------------------------------
EMAIL_ADMIN_EMAIL=admin@example.com
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_USE_TLS=true

# ---------------------------------------------------------------------------
# LLM / AI extraction (LLM_ prefix)
# ---------------------------------------------------------------------------
LLM_OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-5.1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_PDF_RENDER_DPI=150
LLM_PDF_MAX_PAGES=15

# ---------------------------------------------------------------------------
# RingCentral fax integration (RINGCENTRAL_ prefix)
# ---------------------------------------------------------------------------
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
# The RingCentral fax number faxes are received on.
RINGCENTRAL_FAX_NUMBER=
# Shared secret required as a query parameter on the inbound webhook URL,
# since RingCentral does not sign webhook request bodies.
RINGCENTRAL_WEBHOOK_SECRET=
# Destination fax number for outbound Novitas prior-authorization
# package submissions.
RINGCENTRAL_NOVITAS_FAX_NUMBER=
# Email of the admin user who owns ambulance requests auto-drafted from
# an inbound fax (there's no human uploader to attribute them to). If
# unset, or if it doesn't resolve to an active admin, falls back to the
# most recently created admin account.
RINGCENTRAL_FAX_INTAKE_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Redis / Celery (REDIS_ prefix)
# ---------------------------------------------------------------------------
# Either set REDIS_URL directly, or leave it unset and provide the
# individual REDIS_* parameters below.
REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
